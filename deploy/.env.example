# Скопировать в .env и заполнить. Файл .env НЕ коммитить (см. deploy/.gitignore).
DOMAIN=gord.example.com          # домен, A-запись → IP вашего VPS
CS_PASSWORD=change-me-strong     # пароль входа в веб-IDE
ANTHROPIC_API_KEY=               # опционально: ключ Claude API (иначе `claude` /login по подписке)
